# Angel One SmartAPI Live Market Feed Configuration
# SmartAPI Portal: https://smartapi.angelone.in
# API Base Endpoint: https://apiconnect.angelone.in

# 1. Your SmartAPI App API Key (from developer portal)
ANGEL_API_KEY=

# 2. Your Angel One Client Code / User ID (e.g. A123456)
ANGEL_CLIENT_CODE=

# 3. Your Angel One Trading PIN / Password
ANGEL_PIN=

# 4. Your Authenticator TOTP Secret Key (from Angel One 2FA setup in Google Authenticator)
ANGEL_TOTP_SECRET=

# 5. Enable/Disable Angel One SmartAPI Live Feed (true = on, false = Yahoo Finance only)
ANGEL_FEED_ENABLED=true
